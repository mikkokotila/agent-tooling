<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>CALLER_PR_GATES_STATE_DIR</key>
		<string>${HOME}/.local/state/caller-pr-gates</string>
		<key>CLAUDE_CLI</key>
		<string>${HOME}/.local/bin/claude</string>
		<key>CODEX_CLI</key>
		<string>/Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${HOME}/.local/bin</string>
		<key>PYTHONPATH</key>
		<string>${HOME}/.local/share/caller-pr-gates</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>local.caller-pr-monitor</string>
	<key>ProcessType</key>
	<string>Standard</string>
	<key>ProgramArguments</key>
	<array>
		<string>${HOME}/.local/share/caller-pr-stop-gate/bin/python</string>
		<string>-m</string>
		<string>caller_pr_gates.monitor</string>
		<string>serve</string>
		<string>--execute</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>${HOME}/.local/state/caller-pr-gates/monitor.stderr.log</string>
	<key>StandardOutPath</key>
	<string>${HOME}/.local/state/caller-pr-gates/monitor.stdout.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>WorkingDirectory</key>
	<string>${HOME}/.local/share/caller-pr-gates</string>
</dict>
</plist>
